<Window x:Class="Phosphor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Phosphor"
        Title="Phosphor"
        Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource Ui}" FontSize="13"
        Icon="phosphor.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>

    <Border x:Name="Frame" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="150" MinHeight="60"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── title bar ── -->
            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="AdminBadge" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Text="Пользователь"/>
                    <Button x:Name="ElevateButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" FontSize="12" Padding="8,4"
                            VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Click="Elevate_Click"
                            Foreground="{StaticResource AccentBrush}"
                            ToolTip="Перезапустить с правами администратора — выбор сохранится"
                            Content="Повысить права"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource ChromeButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Развернуть"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Закрыть"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Phosphor" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WingetInfo" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Bottom" Text="winget …"/>
                </StackPanel>
            </DockPanel>

            <!-- ── search ── -->
            <Border Grid.Row="1" Margin="24,8,24,20" Height="38" CornerRadius="8"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <DockPanel Margin="14,0,14,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13"
                               Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+F" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SearchHint" Text="Поиск по названию, ID или описанию" FontSize="14"
                                   Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        <TextBox x:Name="SearchBox" FontSize="14" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                 SelectionBrush="{StaticResource MutedBrush}" Padding="0"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ── main: categories | apps ── -->
            <Grid Grid.Row="2" Margin="16,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="CategoryList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CategoryItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CategoryItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12"
                                           Foreground="{StaticResource FaintBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Column="2">
                    <DockPanel DockPanel.Dock="Top" Margin="12,6,12,10">
                        <TextBlock x:Name="ViewInfo" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="AppsTitle" FontSize="15" FontWeight="SemiBold" Text="Все"/>
                    </DockPanel>

                    <Grid>
                        <ScrollViewer x:Name="AppScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" Background="Transparent">
                            <ItemsControl x:Name="AppList" Focusable="False" Margin="0,0,6,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AppItem}">
                                        <CheckBox Style="{StaticResource AppRow}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  ToolTipService.InitialShowDelay="600">
                                            <CheckBox.ToolTip>
                                                <StackPanel MaxWidth="380">
                                                    <TextBlock Text="{Binding Id}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource SubtleBrush}"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </CheckBox.ToolTip>
                                            <DockPanel>
                                                <TextBlock x:Name="status" DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </CheckBox>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallState.Queued}">
                                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallState.Running}">
                                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="pulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="status" Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.45" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="pulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallState.Done}">
                                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static local:InstallState.Failed}">
                                                <Setter TargetName="status" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}" Text="Ничего не найдено"/>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- ── splitter ── -->
            <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent"
                          Cursor="SizeNS" Focusable="False"/>

            <!-- ── log ── -->
            <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,8,24,6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" FontSize="12" Padding="8,3"
                                Foreground="{StaticResource MutedBrush}" Click="OpenLogs_Click" Content="Папка логов"/>
                        <TextBlock Text="Журнал" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource Mono}" FontSize="12"
                                 Padding="0" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto"
                                 SelectionBrush="{StaticResource MutedBrush}" CaretBrush="Transparent">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="LineHeight" Value="18"/>
                            </Style>
                        </RichTextBox.Resources>
                        <FlowDocument PagePadding="0">
                            <Paragraph x:Name="LogPara"/>
                        </FlowDocument>
                    </RichTextBox>
                </DockPanel>
            </Border>

            <!-- ── footer ── -->
            <Border Grid.Row="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SelectButton" Style="{StaticResource GhostButton}" Margin="0,0,2,0" Click="SelectVisible_Click"
                                ToolTip="Выбрать все видимые, повторно — снять (F2)" Content="Выбрать все"/>
                        <Button x:Name="ClearButton" Style="{StaticResource GhostButton}" Margin="0,0,2,0" Click="Clear_Click"
                                ToolTip="Снять всё (F3)" Content="Сбросить"/>
                        <Button x:Name="ReloadButton" Style="{StaticResource GhostButton}" Margin="0,0,2,0" Click="Reload_Click"
                                ToolTip="Перечитать apps.json (F5)" Content="Обновить"/>
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,12,0" Click="EditCatalog_Click"
                                ToolTip="Открыть apps.json в редакторе (F6)" Content="Каталог"/>
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Click="Install_Click"
                                ToolTip="F9" Content="Установить"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedInfo" Text="0 из 0" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}" Width="140" Margin="20,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="ProgressText" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Margin="16,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
