<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 is built into every Windows 10 (1903+) and Windows 11,
    so the resulting Phosphor.exe is a single ~200 KB file with no runtime to install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Phosphor</AssemblyName>
    <RootNamespace>Phosphor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>phosphor.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Phosphor</Product>
    <Description>Portable winget batch installer</Description>
    <Copyright>Copyright © 2026 Phosphor contributors</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Resource Include="phosphor.ico" />
    <EmbeddedResource Include="apps.default.json" LogicalName="Phosphor.apps.default.json" />
  </ItemGroup>

</Project>
